  "scripts": {
    "ng": "ng",
    "start": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng serve",
    "start.local": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy.dev.conf.js",
    "start.tst": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy.tst.conf.js",
    "build.libs": "npm run build.ads-wrapper && npm run build.ef && npm run build.core && npm run build.ps && npm run build.risk && npm run build.eco && npm run build.breakdown && npm run build.eeco && npm run build.lookthrough",
    "build.all": "npm run build.libs && npm run build.app",
    "build.lib": "npm run build.all",
    "build.prod": "npm run build.app",
    "build.ads-wrapper": "ng build explore-ads-wrapper",
    "build.ef": "ng build explore-efficient-frontier",
    "build.ps": "ng build portfolio-search",
    "build.core": "ng build explore-ui-core",
    "build.risk": "ng build explore-ui-risk",
    "build.eco": "ng build explore-ui-column-option",
    "build.eeco": "ng build explore-ui-extended-column-option",
    "build.breakdown": "ng build explore-ui-breakdown",
    "build.lookthrough": "ng build explore-ui-look-through-settings",
    "build.app": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --base-href ./ --configuration production && node custom-script.js",
    "test": "npm run test.ads-wrapper && npm run test.ef && npm run test.ps && npm run test.core && npm run test.risk && npm run test.eco && npm run test.breakdown && npm run test.eeco && npm run test.lookthrough && npm run test.app && npm run junit-merge",
    "test.ps": "node --max_old_space_size=4096 ./node_modules/jest/bin/jest --env=./test-env.js --config jest.lib.portfolio-search.config.js --coverage",
    "test.core": "node --max_old_space_size=4096 ./node_modules/jest/bin/jest --env=./test-env.js --config jest.lib.ui-core.config.js --coverage",
    "test.risk": "node --max_old_space_size=4096 ./node_modules/jest/bin/jest --config jest.lib.ui-risk.config.js --coverage",
    "test.breakdown": "node --max_old_space_size=4096 ./node_modules/jest/bin/jest --config jest.lib.ui-breakdown.config.js --coverage",
    "test.eco": "node --max_old_space_size=4096 ./node_modules/jest/bin/jest --config jest.lib.ui-column-option.config.js --coverage",
    "test.eeco": "node --max_old_space_size=4096 ./node_modules/jest/bin/jest --config jest.lib.ui-extended-column-option.config.js --coverage",
    "test.ef": "node --max_old_space_size=4096 ./node_modules/jest/bin/jest --env=./test-env.js --config jest.lib.efficient-frontier.config.js --coverage",
    "test.lookthrough": "node --max_old_space_size=4096 ./node_modules/jest/bin/jest --env=./test-env.js --config jest.lib.ui-look-through-settings.config.js --coverage",
    "test.ads-wrapper": "node --max_old_space_size=4096 ./node_modules/jest/bin/jest --env=./test-env.js --config jest.lib.ui-ads-wrapper.config.js --coverage",
    "test.app": "node --max_old_space_size=8192 ./node_modules/jest/bin/jest --config jest.config.js --coverage",
    "test.cy": "cypress run",
    "test.cy-local": "cypress run edge --headed",
    "test.ci-local": "start-server-and-test start http-get://localhost:4100/apps/explore-beta test.cy-local",
    "test.ci": "WAIT_ON_TIMEOUT=600000 start-server-and-test start http-get://localhost:4100/apps/explore-beta prepare-and-run",
    "prepare-and-run": "chmod +x ./run-cypress-tests.sh && npm run docker.cypress",
    "docker.cypress": "docker run --rm --network=host -v $PWD:/e2e -w /e2e -e DISPLAY -e HOST_USER=${USER} --entrypoint sh cypress/included:12.3.0 -c './run-cypress-tests.sh'",
    "junit-merge": "junit-merge -d ./test_reports -o test_reports/junit.xml",
    "merge-coverage": "node ./tools/scripts/merge-coverage.js",
    "lint": "eslint --fix \"**/*.+(js|jsx|ts|tsx)\"",
    "e2e": "ng e2e",
    "doc": "npx compodoc -p src/tsconfig.app.json -s -o",
    "doc-watch": "npx compodoc -p src/tsconfig.app.json -w -s",
    "build.stats": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --vendorSourceMap --stats-json && webpack-bundle-analyzer dist/stats.json"
  },
