{
    "configType": "expostStatsWidget",
    "size": {
        "height": 6,
        "width": 8
    },
    "description": "The Ex-Post Statistics Widget displays a summary of portfolio-level returns and statistic information, such as ex-post alphas and betas, information ratio, and Sharpe ratio.\n\nEx-post analysis offers the ability to view top-level performance in the portfolio, benchmark, and active space over longer time horizons. It also allows for the performance of statistical analysis of alpha, beta, and various other ratios and metrics based on that data.",
    "title": "Ex-Post Statistics",
    "image": ".\/assets\/images\/riskExposureWidget.png",
    "showOnlySingleColumn": false,
    "showInSelector": true,
    "tokenToCheck": "enableExpost",
