{
  "configType": "praTimeSeries",
  "size": {
    "height": 6,
    "width": 8
  },
  "description": "FBA Time Series Chart",
  "title": "Time series chart",
  "image": ".\/assets\/images\/timeseriesWidget.png",
  "showInSelector": false,
  "includePerformanceBreakdown": false,
  "restrictBreakdownToSingleLevel": false,
  "showOnlySingleColumn": true,
  "showGridTransitionControl": false,
  "exportType": "pdf",
  "inputCategories": [
    {
      "categoryType": "columns",
      "categoryTitle": "Measure",
      "noAccordion": true,
      "inputs": [
        {
          "inputConfigType": "columns",
          "inputName": "columns",
          "showFavorite": false,
          "valueField": "columnTag",
          "columnFilters": [
            {
              "type": "=",
              "key": "columnReports",
              "value": [
                "prism_var_factors",
                "factor_attrib_dd",
                "factor_attrib_resid"
              ]
            },
            {
              "type": "!=",
              "key": "columnType",
              "value": [
                "FACTOR_ATTRIBUTES",
                "custom_calc"
              ]
            },
            {
              "type": "!=",
              "key": "isVisible",
              "value": false
            },
            {
              "type": "!=",
              "key": "columnReports",
              "value": [
                "prism_custom_cal",
                "explore_filter"
              ]
            }
          ],
          "hiddenColumns": [
            {
              "columnTag": "rfv_block_path",
              "positionColumnType": "ALL",
              "columnKey": "rfv_block_path"
            },
            {
              "columnTag": "rfv_ftitle",
              "positionColumnType": "ALL",
              "columnKey": "rfv_ftitle"
            },
            {
              "columnTag": "rfv_ftitle_long",
              "positionColumnType": "ALL",
              "columnKey": "rfv_ftitle_long"
            }
          ],
          "isOpen": true
        }
      ]
    },
    {
      "categoryType": "settings",
      "categoryTitle": "Settings",
      "inputs": [
        {
          "inputConfigType": "timeSeriesTimePeriodSettings",
          "inputName": "timeSeriesSettings",
          "otherNames": ["date"],
          "inputTitle": "Time period",
          "default": {
            "frequency": "MONTH_END",
            "periods": 3,
            "includeTotalValues": true
          },
          "isOpen": true
        }
      ]
    },
    {
      "categoryType": "axis",
      "categoryTitle": "Axis",
      "inputs": [
        {
          "inputConfigType": "primaryAxisSettings",
          "inputName": "primaryAxisSettings",
          "inputTitle": "Primary axis",
          "default": {},
          "isOpen": true
        }
      ]
    },
    {
      "categoryType": "Settings",
      "categoryTitle": "Format",
      "inputs": [
        {
          "inputConfigType": "timeSeriesFormatSettings",
          "inputName": "timeSeriesSettings",
          "isSharedInputName": true,
          "otherNames": ["date"],
          "inputTitle": "Chart format",
          "isOpen": true
        },
        {
          "inputConfigType": "comboChartColumnSettings",
          "inputName": "comboChartColumnSettings",
          "inputTitle": "Chart type and axis selection",
          "isOpen": true,
          "otherNames": ["secondaryAxisColumn"],
          "default": {
            "columns": []
          }
        }
      ]
    },
    {
      "visible": false,
      "categoryType": "chartSettings",
      "inputs": [
        {
          "inputConfigType": "chartSettings",
          "inputName": "chartSettings",
          "default": {
            "legendShow": true,
            "labelShow": false
          }
        }
      ]
    },
    {
      "visible": false,
      "categoryType": "nestedSettings",
      "inputs": [
        {
          "inputConfigType": "gridLines",
          "inputName": "showGridLines",
          "inputTitle": "Grid lines",
          "default": true
        }
      ]
    },
    {
      "$ref": "factorPathInput"
    }
  ],
  "restrictedColumnOptions": {
    "sections": [
      "columnBreakdown",
      "overrideDateColumnOption",
      "aggregation",
      "highlight",
      "chartType",
      "economyExposureSettings",
      "ConstraintMissingDataHandling"
    ]
  },
  "chartingLib": "hc"
}
