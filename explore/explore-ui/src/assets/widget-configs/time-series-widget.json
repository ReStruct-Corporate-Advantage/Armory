{
    "configType": "ts",
    "size": {
        "height": 6,
        "width": 8
    },
    "showInSelector": true,
    "includePerformanceBreakdown": false,
    "restrictBreakdownToSingleLevel": false,
    "showOnlySingleColumn": false,
    "showGridTransitionControl": true,
    "isEligibleForLightLookthrough": true,
    "description": "The Time Series Chart Widget plots one or more data points sequentially, showing changes or trends over a customizable time period. The x-axis plots dates and the y-axis plots data points, allowing you to analyze a sequence of data points collected over a customizable interval of time.",
    "title": "Time Series Chart",
    "image": ".\/assets\/images\/time-series-chart.png",
    "imageDescription": "This time series chart is a VaR analysis showing the active risk contribution and risk contribution of Microsoft Corp (Cusip 594918104) over a 15 day time period in an equity portfolio.",
    "setUpRequirements": [
      "1 (or more) column measures",
      "Optional: Sector breakdown"
    ],
    "inputCategories": [
        {
            "$ref": "defaultNotionalNumericColumns"
        },
        {
            "categoryType": "breakdown",
            "categoryTitle": "Breakdown",
            "noAccordion": true,
            "inputs": [
                {
                    "$ref": "defaultBreakdown"
                },
                {
                    "inputConfigType": "isLightLookthroughEnabled",
                    "inputName": "isLightLookthroughEnabled",
                    "inputTitle": "Enable Fund Characteristics View",
                    "hideTitle": true,
                    "default": {}
                }
            ]
        },
        {
            "categoryType": "filter",
            "categoryTitle": "Filter",
            "inputs": [
                {
                  "inputConfigType": "hideUnassignedFilter",
                  "inputName": "hideUnassignedFilter",
                  "inputTitle": "Hide 'Unassigned'",
                  "default": {}
                },
                {
                    "inputConfigType": "customFilter",
                    "inputName": "filter",
                    "otherNames": ["customFilter"],
                    "inputTitle": "Advanced filtering",
                    "default": {},
                    "valueField": "columnTag",
                    "isOpen": true
                },
                {
                    "inputConfigType": "normalizedFlag",
                    "inputName": "normalizedWidgetFilter",
                    "otherNames": ["normalizedFlag"],
                    "inputTitle": "Test",
                    "default": {
                      "data": false
                    }
                }
            ]
        },
        {
            "categoryType": "settings",
            "categoryTitle": "Settings",
            "inputs": [
                {
                  "inputConfigType": "timeSeriesTimePeriodSettings",
                  "inputName": "timeSeriesSettings",
                  "inputTitle": "Time period",
                  "default": {
                      "frequency": "DAILY",
                      "periods": 10,
                      "includeTotalValues": false,
                      "showDataMarker": true
                  },
                  "isOpen": true
                }
            ]
        },
        {
            "categoryType": "axis",
            "categoryTitle": "Axis",
            "inputs": [
                {
                    "inputConfigType": "primaryAxisSettings",
                    "inputName": "primaryAxisSettings",
                    "inputTitle": "Primary axis",
                    "default": {},
                    "isOpen": true
                },
                {
                    "inputConfigType": "secondaryAxisSettings",
                    "inputName": "secondaryAxisSettings",
                    "inputTitle": "Secondary axis",
                    "default": {},
                    "isOpen": true
                }
            ]
        },
        {
            "categoryType": "Settings",
            "categoryTitle": "Format",
            "inputs": [
                {
                    "inputConfigType": "timeSeriesFormatSettings",
                    "inputName": "timeSeriesSettings",
                    "isSharedInputName": true,
                    "otherNames": ["date"],
                    "inputTitle": "Chart format",
                    "isOpen": true
                },
              {
                "inputConfigType": "comboChartColumnSettings",
                "inputName": "comboChartColumnSettings",
                "inputTitle": "Chart type and axis selection",
                "isOpen": true,
                "otherNames": ["secondaryAxisColumn"],
                "default": {
                  "columns": []
                }
              }
            ]
        },
        {
          "visible": false,
          "categoryType": "chartSettings",
          "inputs": [
            {
              "inputConfigType": "chartSettings",
              "inputName": "chartSettings",
              "default": {
                "legendShow": true,
                "labelShow": false
              }
            }
          ]
        },
        {
          "visible": false,
          "categoryType": "nestedSettings",
          "inputs": [
            {
              "inputConfigType": "gridLines",
              "inputName": "showGridLines",
              "inputTitle": "Grid lines",
              "default": true
            }
          ]
        }
    ],
    "restrictedColumnOptions": {
        "sections": [
            "columnBreakdown",
            "overrideDateColumnOption",
            "highlight",
            "chartType",
            "ConstraintMissingDataHandling"
        ]
    },
    "customCalculationColumn": {
        "$ref": "customCalculationColumn"
    },
    "styleAnalysis": {
      "$ref": "styleAnalysis"
    },
    "chartingLib": "hc"
}
